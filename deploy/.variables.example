IMAGE_NAME=mhc-sos-cms
IMAGE_TAG=latest
CONTAINER_NAME=mhc-sos-cms
CMS_SOURCE_PATH=/absolute/path/to/mhc-sos-cms
APP_PORT=1880
APP_BASE_URL=https://mhc.example.com/
TRUSTED_PROXY_IPS=
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
DB_DRIVER=mysqli
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_SECURE=tls
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=MHC SOS
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=900
AUTH_RATE_LIMIT_LOCKOUT=900
AUTH_CAPTCHA_TTL=300
